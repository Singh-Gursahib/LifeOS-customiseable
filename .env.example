# =============================================================================
# LifeOS — environment. Copy to .env.local and fill in:   cp .env.example .env.local
# .env.local is gitignored. Never commit real values.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET key (sb_secret_…) or the legacy service_role JWT. Server-only: the
# browser never talks to Supabase, so you do NOT need the publishable/anon key.
SUPABASE_SECRET_KEY=

# --- Auth (required) ---------------------------------------------------------
# Signs the session cookie and peppers the PIN hashes. At least 32 characters.
# Generate one:   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later signs everyone out AND invalidates both PINs (re-run set-pin).
AUTH_SECRET=

# --- OpenRouter (required) ---------------------------------------------------
# https://openrouter.ai/settings/keys — one key powers everything: voice
# transcription, the Ask assistant and ingestion. Needs a little credit
# (a capture costs well under a cent). Extra comma-separated keys = failover.
OPENROUTER_API_KEYS=sk-or-v1-
# Optional — both default to google/gemini-3.7-flash.
# OPENROUTER_MODEL=google/gemini-3.7-flash
# OPENROUTER_TRANSCRIBE_MODEL=google/gemini-3.7-flash

# --- Direct Gemini fallback (optional) ---------------------------------------
# Only used for transcription if OpenRouter is unreachable. Leave unset to skip.
# https://aistudio.google.com/apikey — comma-separate several to rotate.
# GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-3.5-flash
